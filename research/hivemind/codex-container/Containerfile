FROM docker.io/library/docker:29.8.2-cli AS docker_cli

FROM docker.io/library/node:22-bookworm-slim

# Client tools only: the Docker daemon remains on the host.
COPY --from=docker_cli /usr/local/bin/docker /usr/local/bin/docker
COPY --from=docker_cli /usr/local/libexec/docker/cli-plugins/ /usr/local/libexec/docker/cli-plugins/

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        bash ca-certificates curl git ripgrep procps \
        python3 python3-pip python3-venv build-essential \
    && rm -rf /var/lib/apt/lists/* \
    && npm install -g @openai/codex \
    && npm cache clean --force \
    && python3 -m venv /opt/dev-tools \
    && /opt/dev-tools/bin/pip install --no-cache-dir uv 'ruff==0.11.2' 'pytest==8.3.5' debugpy

RUN docker --version && docker compose version && docker buildx version

ENV HOME=/home/node
ENV PATH="/opt/dev-tools/bin:${PATH}"
USER node
WORKDIR /workspace
CMD ["codex", "--no-daemon", "--sandbox", "danger-full-access", "--ask-for-approval", "never"]
