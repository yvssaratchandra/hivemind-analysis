# Additional frozen native dependency copies.
**/native_source/

# Announcement probe: bulky per-condition tensors and bundled source snapshots
# (hashes are in each condition provenance.json and in LOCAL_ARTIFACTS.json).
announcement_s1_*/*/outputs.json
announcement_s1_*/*/sources.tar.gz

# Superseded same-session announcement intermediates kept local only:
# _a = initial run that hit the native teardown broken-pipe abort (now fixed);
# _b = first clean run analyzed with the pre-fix analyzer. _c is authoritative.
/announcement_s1_20261020_a/
/announcement_s1_20261020_b/

# Learning programme: full evidence is local and hashed in each run's
# artifact_inventory.json; compact configs, status, checks and reports are tracked.
announcement_e*/*/outputs.json
announcement_e*/*/sources.tar.gz
announcement_e*/*/inputs.json
announcement_e*/learning_data.npz
announcement_e*/trajectory.json
announcement_e*/round_*_requested_inputs.json
announcement_e*/round_*/
announcement_e*/cases/
announcement_e*/review_harness/
announcement_learning_*/problems/
announcement_learning_*/runs/
