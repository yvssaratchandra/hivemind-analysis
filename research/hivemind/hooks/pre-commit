#!/usr/bin/env bash
# Regenerate the one-page sheets when their sources are staged.
#
# Both generators parse their sources, so they cannot disagree with them about
# content -- but they only run when invoked, so the committed PDF silently falls
# a version behind whenever someone edits the source and forgets. That happened
# at 566844a: three Select cells changed and the sheet stayed as generated at
# 94a8626.
#
# This hook is tracked in the repo, unlike .git/hooks, but git still has to be
# told to look here. Once per clone:
#
#     git config core.hooksPath research/hivemind/hooks
#
# Skip it for a single commit with `git commit --no-verify`.

set -euo pipefail

root="$(git rev-parse --show-toplevel)"
cd "$root"

python="$root/.venv/bin/python"
[ -x "$python" ] || python="$(command -v python3 || true)"
if [ -z "$python" ]; then
    echo "pre-commit: no python found; skipping sheet regeneration" >&2
    exit 0
fi

staged="$(git diff --cached --name-only --diff-filter=ACM)"

regenerate() {
    local script="$1" pdf="$2" why="$3"
    echo "pre-commit: $why -- regenerating $(basename "$pdf")"
    if ! "$python" "$root/$script" >/dev/null 2>&1; then
        echo "pre-commit: $script failed; commit anyway and regenerate by hand" >&2
        return 0
    fi
    # Only stage it if the regeneration actually changed something. A PDF can
    # differ byte-for-byte on every run (embedded timestamps), so compare the
    # extracted text where pdftotext is available and fall back to staging.
    if command -v pdftotext >/dev/null 2>&1; then
        local before after
        before="$(mktemp)"; after="$(mktemp)"
        git show ":$pdf" 2>/dev/null | pdftotext -layout - "$before" 2>/dev/null || : > "$before"
        pdftotext -layout "$root/$pdf" "$after" 2>/dev/null || : > "$after"
        if cmp -s "$before" "$after"; then
            git checkout -- "$pdf" 2>/dev/null || true
            rm -f "$before" "$after"
            echo "pre-commit: $(basename "$pdf") already current"
            return 0
        fi
        rm -f "$before" "$after"
    fi
    git add "$pdf"
    echo "pre-commit: staged $(basename "$pdf")"
}

if grep -q '^research/hivemind/CONTROL_DATA_AUDIT\.md$' <<<"$staged"; then
    regenerate research/hivemind/make_map_sheet.py research/hivemind/control_data_map.pdf \
        "CONTROL_DATA_AUDIT.md is staged"
fi

if grep -qE '^research/hivemind/results/step10_(baseline_rw_n|delay_n8_k1_reads5|stale_n8_w20).*\.csv$' <<<"$staged"; then
    regenerate research/hivemind/make_timing_sheet.py research/hivemind/hivemind_dht_timings.pdf \
        "a timing CSV is staged"
fi

exit 0
